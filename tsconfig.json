{
  "include": [
    "/**/*",
    "./packages/**/*",
    "./projects/**/*"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "target": "es2021",
    "module": "commonjs",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "esModuleInterop": true,
    "paths": {
      "@pkg/*": [
        "./packages/*"
      ],
      "@proj/*": [
        "./projects"
      ],
    },
  }
}